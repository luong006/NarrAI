# ==========================================
# NarrAI Backend Environment Variables (.env)
# ==========================================

# Groq API Keys (Đăng ký tại https://console.groq.com)
# Bạn có thể dùng chung 1 key hoặc chia tách để tối ưu hạn mức rate-limit
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_KEY_BIBLE=gsk_your_groq_bible_key_here
GROQ_API_KEY_COPILOT=gsk_your_groq_copilot_key_here
GROQ_API_KEY_COMIC=gsk_your_groq_comic_key_here

# JWT Authentication
# LƯU Ý BẢO MẬT: Hãy tạo chuỗi ngẫu nhiên an toàn trong môi trường Production
# Ví dụ tạo key mạnh trên Linux/Mac: openssl rand -hex 32
# Đặt tên biến này trên Render Dashboard: JWT_SECRET
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Cloudflare Workers AI (dùng cho tính năng sinh ảnh Manga)
# Đăng ký tại https://dash.cloudflare.com → Workers AI
# CLOUDFLARE_ACCOUNT_ID: Tìm ở trang chủ Cloudflare Dashboard (cột phải)
# CLOUDFLARE_API_TOKEN: Tạo tại https://dash.cloudflare.com/profile/api-tokens
#   → Chọn template "Cloudflare Workers AI (Read)" hoặc tạo custom token
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Database Configuration (Mặc định SQLite WAL mode)
DATABASE_URL=sqlite:///./narrai.db

# Server Port (Mặc định: 8000; Render tự động cấp qua biến PORT - không cần đặt thủ công)
PORT=8000